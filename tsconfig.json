{
  "$schema": "https://www.schemastore.org/tsconfig",
  "_version": "24.0.0",

  "compilerOptions": {
    "lib": [
      "es2025",
      "dom",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Iterator",
      "ESNext.Promise"
    ],
    "rootDir": "./src",
    "types": ["node"],
    "module": "nodenext",
    "target": "es2025",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    "skipLibCheck": true,
    "moduleResolution": "nodenext"
  },
  "include": ["src"]
}
